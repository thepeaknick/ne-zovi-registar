{
  "Application": {
    "Name": "NeZoviReg.",
    "Title": "Ne-zovi registar",
    "Version": "1",
    "Description": "Registar potrošača koji ne žele primati pozive i/ili poruke u okviru promocije i/ili prodaje telefonom."
  },

  "ConnectionStrings": {
    "SqlServerDatabase": "Dummy",
    "MySqlDatabase": "Dummy"
  },
  
  "RateLimit": {
    "FixedWindowAnonymous": {
      "PermitLimit": "5",
      "WindowInSeconds": "120",
      "QueueLimit": "0"
    },
    "FixedWindowAuthenticated": {
      "PermitLimit": "30",
      "WindowInSeconds": "60",
      "QueueLimit": "0"
    }
  },
  "Email": {
    "EmailEnabled": true,
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": "true",
    "EmailFrom": "nezovi871@gmail.com",    
    "Username": "nezovi871@gmail.com",
    "Password": "nuchxhhtezjoknog",
    "EmailTo": "nezovi871@gmail.com"
  },

  "ForgotPassword": {       
    "Subject": "Reset lozinke",
    "HtmlTemplatePath": "Templates\\reset_password.html",
    "CallBackUrl": "{CallBackUrl}"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Enrichers.ClientInfo" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "System": "Warning",
        "Microsoft.AspNetCore.Mvc.RazorPages": "Warning"
      }
    },
    "Enrich": [ {
      "Name": "WithClientIp",
      "Args": {
        "headerName": "CF-Connecting-IP"
        }
      },
      "FromLogContext", 
      "WithMachineName", 
      "WithThreadId" ],
    "Properties": {
      "Application": "NeZoviReg"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {SourceContext} [{Level}] ClientIP: {ClientIp} {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "./Logs/logs.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 15,
          "outputTemplate": "[{Timestamp:HH:mm:ss} {SourceContext} [{Level}] ClientIP: {ClientIp} {Message}{NewLine}{Exception}",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]    
  },
  
  "AllowedHosts": "*",
  
  "Jwt": {
    "Issuer": "NeZoviReg",
    "Audience": "NeZoviReg",
    "SecretKey": "!!hah@hhahahah_dovoljno_dugackopfffffffffffffrtyy=======trrrrr",
    "AccesTokenExpirationInMinutes": "15",
    "RefreshTokenExpirationInDays": "1"
  },
  
  "Bulk": {
    "BatchSize": "500"
  },
  "XmlDoc": {
    "Assemblies": [
      "NeZoviReg.WebApi",
      "NeZoviReg.Abstractions"
    ]
  },

  "AprWebClient": {
    "BaseUrl" : "https://service1.apr.gov.rs:4430/plws/PlService.svc"    
  }
}
