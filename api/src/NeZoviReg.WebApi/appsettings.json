{
  "Application": {
    "Name": "NeZoviReg.",
    "Title": "Ne-zovi registar",
    "Version": "1",
    "Description": "Registar potrošača koji ne žele primati pozive i/ili poruke u okviru promocije i/ili prodaje telefonom."
  },

  "ConnectionStrings": {
    //"SqlServerDatabase": "Server=sql_server2022;Database=NeZoviReg;User Id=SA;Password=Nezovitest@123;Trusted_Connection=False;MultipleActiveResultSets=True;Connection Timeout=30;TrustServerCertificate=true;"
    "SqlServerDatabase": "Server=sql_server2022;Database=NeZoviReg;User Id=SA;Password=Nezovitest@123;Trusted_Connection=False;MultipleActiveResultSets=True;Connection Timeout=30;TrustServerCertificate=true;"
  },


  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RateLimit": {
    "FixedWindow": {
      "PermitLimit": "10",
      "WindowInSeconds": "30",
      "QueueLimit": "0"
    }
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning",
        "Microsoft.AspNetCore.Mvc.RazorPages": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {SourceContext} [{Level}] {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "../Logs/logs.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "outputTemplate": "[{Timestamp:HH:mm:ss} {SourceContext} [{Level}] {Message}{NewLine}{Exception}",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "NeZoviReg"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "NeZoviReg",
    "Audience": "NeZoviReg",
    "SecretKey": "hahahhahahah_dovoljno_dugackopfffffffffffffffrtyy=======trrrrr",
    "AccesTokenExpirationInMinutes": "15",
    "RefreshTokenExpirationInDays": "1"
  }
}
