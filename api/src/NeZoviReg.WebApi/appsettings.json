{
  "Application": {
    "Name": "NeZoviReg.",
    "Title": "Не зови регистар",
    "Version": "1",
    "Description": "Регистар потрошача који не желе примати позиве и/или поруке у оквиру промоције и/или продаје телефоном."
  },

  "ConnectionStrings": {
    "SqlServerDatabase": "Server=sql_server2022;Database=NeZoviReg;User Id=SA;Password=Nezovitest@123;Trusted_Connection=False;MultipleActiveResultSets=True;Connection Timeout=30;TrustServerCertificate=true;"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RateLimit": {
    "FixedWindow": {
      "PermitLimit": "10",
      "WindowInSeconds": "30",
      "QueueLimit": "0"
    }
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning",
        "Microsoft.AspNetCore.Mvc.RazorPages": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {SourceContext} [{Level}] {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "../Logs/logs.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "outputTemplate": "[{Timestamp:HH:mm:ss} {SourceContext} [{Level}] {Message}{NewLine}{Exception}",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "NeZoviReg"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "NeZoviReg",
    "Audience": "NeZoviReg",
    "SecretKey": "hahahhahahah_dovoljno_dugackopfffffffffffffffrtyy=======trrrrr"
  }
}
